{
  "name": "agent-clinic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "ingest": "tsx --env-file=.env src/rag/ingest.ts",
    "chat": "tsx --env-file=.env src/agent/cli.ts",
    "eval:retrieval": "tsx --env-file=.env evals/run.ts --category retrieval",
    "eval": "tsx --env-file=.env evals/run.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
